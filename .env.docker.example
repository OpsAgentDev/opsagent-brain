# Env for the compose `brain` profile (docker compose --profile brain up). Local only: never reuse these values.
# LOCO_ENV=development because the production image config refuses a non-loopback SMTP relay (mailpit).
LOCO_ENV=development
PORT=3000
BINDING=0.0.0.0
DATABASE_URL=postgres://loco:loco@postgres:5432/opsagent_brain_development
REDIS_URL=redis://redis:6379
APP_BASE_URL=http://localhost:3000
WEB_BASE_URL=http://localhost:3001
SESSION_SECRET=local-only-session-secret-change-me
# Keys unsubscribe links; blank falls back to SESSION_SECRET.
UNSUBSCRIBE_SECRET=local-only-unsubscribe-secret-change-me
OPSAGENT_KEK=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
OPSAGENT_CONNECTORS=fake
MAILER_SMTP_URL=smtp://mailpit:1025
# Slack OAuth (placeholders; blank disables Connect Slack). Never commit real values.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
MAIL_FROM=OpsAgent <login@opsagent.local>
