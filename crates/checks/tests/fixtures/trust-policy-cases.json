[
  {
    "name": "a bare * principal",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": "*"
        }
      ]
    },
    "expect": [
      {
        "variant": "any_principal",
        "severity": "critical"
      }
    ]
  },
  {
    "name": "AWS: *",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": "*"
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "any_principal",
        "severity": "critical"
      }
    ]
  },
  {
    "name": "AWS: [*]",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": [
              "*"
            ]
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "any_principal",
        "severity": "critical"
      }
    ]
  },
  {
    "name": "an empty Condition does not count",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": "*"
          },
          "Condition": {}
        }
      ]
    },
    "expect": [
      {
        "variant": "any_principal",
        "severity": "critical"
      }
    ]
  },
  {
    "name": "a * principal behind a condition",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": "*"
          },
          "Condition": {
            "StringEquals": {
              "aws:PrincipalOrgID": "o-1"
            }
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "any_principal_conditional",
        "severity": "medium"
      }
    ]
  },
  {
    "name": "a * principal with sts:* and a lower-case action",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "STS:Assumerole"
          ],
          "Principal": {
            "AWS": "*"
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "any_principal",
        "severity": "critical"
      }
    ]
  },
  {
    "name": "a * principal with the * action",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "*",
          "Principal": {
            "AWS": "*"
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "any_principal",
        "severity": "critical"
      }
    ]
  },
  {
    "name": "a single statement that is an object, not a list",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": {
        "Effect": "Allow",
        "Action": "sts:AssumeRole",
        "Principal": {
          "AWS": "*"
        }
      }
    },
    "expect": [
      {
        "variant": "any_principal",
        "severity": "critical"
      }
    ]
  },
  {
    "name": "an account id with no external id",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": "444455556666"
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "foreign_account_no_external_id",
        "severity": "medium"
      }
    ]
  },
  {
    "name": "an account principal, array form",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": [
              "arn:aws:iam::444455556666:root"
            ]
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "foreign_account_no_external_id",
        "severity": "medium"
      }
    ]
  },
  {
    "name": "several foreign accounts are one finding",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": [
              "444455556666",
              "arn:aws:iam::777788889999:role/x"
            ]
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "foreign_account_no_external_id",
        "severity": "medium"
      }
    ]
  },
  {
    "name": "a foreign account whose condition is not an external id",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": "444455556666"
          },
          "Condition": {
            "StringEquals": {
              "aws:PrincipalOrgID": "o-1"
            }
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "foreign_account_no_external_id",
        "severity": "medium"
      }
    ]
  },
  {
    "name": "a foreign account on a gov partition ARN",
    "role_arn": "arn:aws:iam::123456789012:role/r",
