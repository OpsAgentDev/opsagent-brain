      }
    ]
  },
  {
    "name": "a role holding all three kinds",
    "role_arn": "arn:aws:iam::123456789012:role/r",
    "trust_policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": "*"
          }
        },
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": "*"
          },
          "Condition": {
            "StringEquals": {
              "aws:PrincipalOrgID": "o-1"
            }
          }
        },
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Principal": {
            "AWS": "444455556666"
          }
        }
      ]
    },
    "expect": [
      {
        "variant": "any_principal",
        "severity": "critical"
      },
      {
        "variant": "any_principal_conditional",
        "severity": "medium"
      },
      {
        "variant": "foreign_account_no_external_id",
        "severity": "medium"
      }
    ]
  },
