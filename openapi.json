  "components": {
    "schemas": {
      "AuthorizeUrl": {
        "type": "object",
        "required": [
          "url"
        ],
        "properties": {
          "url": {
            "type": "string"
          }
        }
      },
      "Connection": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "status",
          "created_at"
        ],
        "properties": {
          "api_rate_ceiling": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "billable_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "briefing_time_local": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "external_account_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "first_connected_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "last_verification": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Verification"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider": {
            "type": "string"
          },
          "scan_time_local": {
            "type": [
              "string",
              "null"
            ],
            "description": "`HH:MM` in the organisation's timezone."
          },
          "status": {
            "type": "string",
            "description": "`pending`, `verifying`, `connected`, `degraded`, `revoked`, `blocked` or `disconnected`."
          },
          "status_reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "template_version": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ConnectionPatch": {
        "type": "object",
        "properties": {
          "api_rate_ceiling": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "At least 1."
          },
          "briefing_time_local": {
            "type": [
              "string",
              "null"
            ],
            "description": "`HH:MM`."
          },
          "display_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "scan_time_local": {
            "type": [
              "string",
              "null"
            ],
            "description": "`HH:MM`."
          }
        }
      },
      "CreatedConnection": {
        "type": "object",
        "required": [
          "id",
          "template_version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "quick_create_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "CloudFormation quick-create link for the read role; null for test providers."
          },
          "template_version": {
            "type": "string"
          }
        }
      },
      "Csrf": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "Send as `X-CSRF-Token` on every mutating request."
          }
        }
      },
      "Disconnected": {
        "type": "object",
        "required": [
          "status",
          "next_step"
        ],
        "properties": {
          "next_step": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "Always `disconnected`."
          }
        }
      },
      "Invite": {
        "type": "object",
        "required": [
          "id",
          "email",
          "role",
          "expires_at"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string"
          }
        }
      },
      "MagicLinkRequest": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "Me": {
        "type": "object",
        "required": [
          "id",
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Member": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "type": "string"
          },
          "user_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Organisation id."
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "NewConnection": {
        "type": "object",
        "required": [
          "provider",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "provider": {
            "type": "string",
            "description": "`aws`."
          }
        }
      },
      "NewInvite": {
        "type": "object",
        "required": [
          "email",
          "role"
        ],
        "properties": {
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "`owner` or `member`."
          }
        }
      },
      "NewOrg": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ],
            "description": "IANA zone; default `UTC`."
          }
        }
      },
      "Org": {
        "type": "object",
        "required": [
          "id",
          "name",
          "slug",
          "timezone",
          "role",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "description": "The caller's role: `owner` or `member`."
          },
          "slug": {
            "type": "string"
          },
          "timezone": {
            "type": "string"
          }
        }
      },
      "OrgPatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "timezone": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Problem": {
        "type": "object",
        "description": "The wire shape of every error (`application/problem+json`).",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable machine-readable code, e.g. `not_found`, `validation`, `rate_limited`, `csrf`."
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string",
            "description": "Unique per response."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        }
      },
      "RedeemRequest": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string"
          }
        }
      },
      "Redirect": {
        "type": "object",
        "required": [
          "redirect"
        ],
        "properties": {
          "redirect": {
            "type": "string"
          }
        }
      },
      "RunAccepted": {
        "type": "object",
        "description": "202 body for endpoints that enqueue a run.",
        "required": [
          "run_id"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Verification": {
        "type": "object",
        "required": [
          "outcome",
          "at",
          "extra_grants",
          "missing_grants"
        ],
        "properties": {
          "assume_with_ok": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "assume_without_denied": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "extra_grants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IAM action names granted beyond the template."
          },
          "missing_grants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "IAM action names the template grants but the role lacks."
          },
          "outcome": {
            "type": "string",
            "description": "Verification outcome code."
          },
          "policy_matches": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      },
      "VerifyBody": {
        "type": "object",
        "properties": {
          "role_arn": {
            "type": "string",
            "description": "The read role's ARN from the stack outputs (required for `aws`)."
          }
        }
      }
    }
  }
}
